# OpenRouter is used only for offline prompt/candidate generation.
# Do not commit real API keys. Copy this file to .env and fill the values there.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cheap bulk generator. Good for many compact prompt variants.
OPENROUTER_FACTORY_MODEL=qwen/qwen3-coder

# Stronger architect/reviewer. Good for hard families and mutation strategy.
OPENROUTER_REVIEW_MODEL=z-ai/glm-5.2

# Optional attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ai-agent-security-kaggle
